rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email != null;
    }

    // 1. Penginapan (Villas & Cabins)
    match /penginapan/{id} {
      // Public can read all active stays; admin can read drafts/inactive
      allow read: if true;
      // Strictly authenticated admin can create, update, delete
      allow create: if isAdmin() 
        && request.resource.data.nama is string 
        && request.resource.data.harga is number 
        && request.resource.data.harga >= 0;
      allow update: if isAdmin() 
        && request.resource.data.nama is string 
        && request.resource.data.harga is number;
      allow delete: if isAdmin();
    }

    // 2. Tours & Jeep 4x4 Experiences
    match /tours/{id} {
      allow read: if true;
      allow create: if isAdmin() 
        && request.resource.data.nama is string 
        && request.resource.data.harga is number 
        && request.resource.data.harga >= 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 3. System & Site Settings (Gallery, Homepage, Calendar)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Reservations & Calendar Holds (Sensitive data)
    match /reservations/{resId} {
      // Public cannot inspect other guests' bookings
      allow read: if isAdmin();
      // Admin controls reservation confirmations
      allow write: if isAdmin();
    }

    // Deny all other unmatched paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
